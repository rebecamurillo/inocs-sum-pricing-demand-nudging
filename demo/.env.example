# Copy to .env to change a value. Without a .env file every variable has the default shown.
# Read by compose.yaml, compose.e2e.yaml and the Makefile. No quotes around values.
#
# The API's and the worker's own settings (PRICING_DEMO_*) are derived from the values below by
# the Makefile and the Compose files; the five optional worker settings at the end are the only
# PRICING_DEMO_* names read from here. Two more variables are derived too: the web dev
# server's proxy target (API_PROXY_TARGET, from API_PORT) and the address the Playwright suite
# opens (E2E_BASE_URL, from E2E_WEB_PORT). Set the ports, not the derived variables: the
# Makefile overrides them.

# Host port of PostgreSQL in the local stack (compose.yaml).
DB_PORT=5440

# Host port of the API (compose.yaml, make dev).
API_PORT=8100

# Host port of the web app (compose.yaml, make dev).
WEB_PORT=4400

# Host port of OpenTripPlanner (compose.yaml, profile otp; make dev points the API at it).
OTP_PORT=8080

# Java heap of OpenTripPlanner, building the graph and serving it (compose.yaml, profile otp).
OTP_HEAP=8g

# Adapter set of the API and the worker: real (package, solver, OpenTripPlanner) or fake
# (compose.yaml, make dev, make worker).
ADAPTERS=real

# Host port of the web app in the e2e stack (compose.e2e.yaml, make e2e).
E2E_WEB_PORT=14400

# Host port of the throwaway PostgreSQL that make test-integration starts.
INTEGRATION_DB_PORT=5441

# Arguments of `playwright install` in make install; empty skips the browser download.
PLAYWRIGHT_ARGS=chromium

# Where the worker keeps its working directories and artefacts. On the host (make worker,
# make dev) the path is relative to demo/api/. Optional; default var/data.
# PRICING_DEMO_DATA_DIR=var/data

# The worker's identity in the workers table. Optional; default {host}-{pid}.
# PRICING_DEMO_WORKER_ID=

# How often the worker probes the solver, the pricing package and the trip planner and reports
# them to the API, in seconds. Optional; default 30.
# PRICING_DEMO_COMPONENT_REPORT_INTERVAL_S=30

# The pfaedle image the city data import runs in Docker to draw the bus legs on the streets,
# pinned by digest. Optional; the value below is the default.
# PRICING_DEMO_SHAPE_TOOL_IMAGE=ghcr.io/ad-freiburg/pfaedle@sha256:af4fdc647699ea1ffe5150fd1f9d264c465c2876710ea749e8cb284f13abd20d

# Where `make otp-graph` writes OpenTripPlanner's graph and its manifest and where the worker
# reads them to report them. Optional; default demo's otp/data (compose.yaml mounts it).
# `make otp-graph` builds only in demo's otp/data, the folder the otp-build service mounts,
# and refuses another one.
# PRICING_DEMO_OTP_GRAPH_DIR=
