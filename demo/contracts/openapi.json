{
  "components": {
    "schemas": {
      "BlockingReasonResponse": {
        "description": "The component that blocks an action, with that component's own reason.",
        "properties": {
          "component": {
            "$ref": "#/components/schemas/ComponentName"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "component",
          "reason"
        ],
        "title": "BlockingReasonResponse",
        "type": "object"
      },
      "CityDatasetList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CityDatasetResource"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "CityDatasetList",
        "type": "object"
      },
      "CityDatasetResource": {
        "properties": {
          "available_area": {
            "$ref": "#/components/schemas/PolygonResource"
          },
          "gbfs_fetched_at": {
            "format": "date-time",
            "title": "Gbfs Fetched At",
            "type": "string"
          },
          "gtfs_timezone": {
            "title": "Gtfs Timezone",
            "type": "string"
          },
          "gtfs_valid_from": {
            "format": "date",
            "title": "Gtfs Valid From",
            "type": "string"
          },
          "gtfs_valid_to": {
            "format": "date",
            "title": "Gtfs Valid To",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "preset": {
            "$ref": "#/components/schemas/PresetResource"
          },
          "routing_moment": {
            "$ref": "#/components/schemas/RoutingMomentResource"
          }
        },
        "required": [
          "id",
          "name",
          "gtfs_valid_from",
          "gtfs_valid_to",
          "gtfs_timezone",
          "gbfs_fetched_at",
          "available_area",
          "preset",
          "routing_moment"
        ],
        "title": "CityDatasetResource",
        "type": "object"
      },
      "ComponentName": {
        "description": "The parts of the system an action depends on, in the order they are reported.",
        "enum": [
          "storage",
          "runner",
          "solver",
          "package",
          "trip_planner",
          "city_data"
        ],
        "title": "ComponentName",
        "type": "string"
      },
      "ComponentState": {
        "enum": [
          "available",
          "limited",
          "unavailable"
        ],
        "title": "ComponentState",
        "type": "string"
      },
      "ComponentStatusResponse": {
        "properties": {
          "name": {
            "$ref": "#/components/schemas/ComponentName"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "state": {
            "$ref": "#/components/schemas/ComponentState"
          }
        },
        "required": [
          "name",
          "state",
          "reason"
        ],
        "title": "ComponentStatusResponse",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "PolygonResource": {
        "description": "A GeoJSON polygon: one closed ring of [longitude, latitude] positions.",
        "properties": {
          "coordinates": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Polygon",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "title": "PolygonResource",
        "type": "object"
      },
      "PresetResource": {
        "properties": {
          "centre_lat": {
            "title": "Centre Lat",
            "type": "number"
          },
          "centre_lon": {
            "title": "Centre Lon",
            "type": "number"
          },
          "radius_m": {
            "title": "Radius M",
            "type": "integer"
          }
        },
        "required": [
          "centre_lat",
          "centre_lon",
          "radius_m"
        ],
        "title": "PresetResource",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "An error, as a problem document (RFC 9457).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "RoutingMomentResource": {
        "properties": {
          "arrive_by": {
            "title": "Arrive By",
            "type": "boolean"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "provisional": {
            "title": "Provisional",
            "type": "boolean"
          },
          "time": {
            "format": "time",
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "date",
          "time",
          "arrive_by",
          "provisional"
        ],
        "title": "RoutingMomentResource",
        "type": "object"
      },
      "RunFailureResource": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          }
        },
        "required": [
          "step",
          "code",
          "reason"
        ],
        "title": "RunFailureResource",
        "type": "object"
      },
      "RunKind": {
        "enum": [
          "build",
          "pricing",
          "simulation"
        ],
        "title": "RunKind",
        "type": "string"
      },
      "RunList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunResource"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "RunList",
        "type": "object"
      },
      "RunResource": {
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunFailureResource"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Share of failed trip-planner queries; null on every run that is not a build.",
            "title": "Failure Pct"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/RunKind"
          },
          "queue_position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue Position"
          },
          "queued_at": {
            "format": "date-time",
            "title": "Queued At",
            "type": "string"
          },
          "runner": {
            "$ref": "#/components/schemas/RunnerResource"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "state": {
            "$ref": "#/components/schemas/RunState"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/RunStepResource"
            },
            "title": "Steps",
            "type": "array"
          },
          "subject": {
            "$ref": "#/components/schemas/RunSubject"
          }
        },
        "required": [
          "id",
          "kind",
          "subject",
          "state",
          "attempt",
          "queued_at",
          "started_at",
          "finished_at",
          "server_time",
          "queue_position",
          "runner",
          "steps",
          "failure",
          "failure_pct"
        ],
        "title": "RunResource",
        "type": "object"
      },
      "RunState": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "RunState",
        "type": "string"
      },
      "RunStepResource": {
        "properties": {
          "counts": {
            "additionalProperties": true,
            "title": "Counts",
            "type": "object"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "last_duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Duration S"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StepProgress"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "state": {
            "$ref": "#/components/schemas/StepState"
          },
          "step": {
            "$ref": "#/components/schemas/StepName"
          }
        },
        "required": [
          "step",
          "number",
          "period",
          "state",
          "started_at",
          "finished_at",
          "counts",
          "progress",
          "last_duration_s",
          "reason"
        ],
        "title": "RunStepResource",
        "type": "object"
      },
      "RunSubject": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/SubjectType"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "title": "RunSubject",
        "type": "object"
      },
      "RunnerResource": {
        "description": "Whether the process that should work on the run reported within the last 30 s.",
        "properties": {
          "alive": {
            "title": "Alive",
            "type": "boolean"
          },
          "last_heartbeat_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Heartbeat At"
          }
        },
        "required": [
          "alive",
          "last_heartbeat_at"
        ],
        "title": "RunnerResource",
        "type": "object"
      },
      "StepName": {
        "enum": [
          "area",
          "hubs",
          "routes",
          "travellers_and_bikes",
          "pricing_model",
          "traveller_simulation"
        ],
        "title": "StepName",
        "type": "string"
      },
      "StepProgress": {
        "properties": {
          "done": {
            "title": "Done",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "done",
          "total"
        ],
        "title": "StepProgress",
        "type": "object"
      },
      "StepState": {
        "enum": [
          "pending",
          "running",
          "done",
          "kept",
          "failed",
          "cancelled"
        ],
        "title": "StepState",
        "type": "string"
      },
      "SubjectType": {
        "enum": [
          "instance_version",
          "pricing_version"
        ],
        "title": "SubjectType",
        "type": "string"
      },
      "SystemStatusResponse": {
        "properties": {
          "can_build_instances": {
            "$ref": "#/components/schemas/VerdictResponse"
          },
          "can_run_pricing": {
            "$ref": "#/components/schemas/VerdictResponse"
          },
          "can_simulate": {
            "$ref": "#/components/schemas/VerdictResponse"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentStatusResponse"
            },
            "title": "Components",
            "type": "array"
          }
        },
        "required": [
          "components",
          "can_build_instances",
          "can_run_pricing",
          "can_simulate"
        ],
        "title": "SystemStatusResponse",
        "type": "object"
      },
      "VerdictResponse": {
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/BlockingReasonResponse"
            },
            "title": "Reasons",
            "type": "array"
          }
        },
        "required": [
          "allowed",
          "reasons"
        ],
        "title": "VerdictResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Dynamic pricing demonstrator API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/city-datasets": {
      "get": {
        "operationId": "listCityDatasets",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityDatasetList"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "The imported city data sets, oldest first",
        "tags": [
          "city-data"
        ]
      }
    },
    "/api/v1/runs": {
      "get": {
        "operationId": "listRuns",
        "parameters": [
          {
            "description": "Comma-separated run states to keep, such as queued,running.",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated run states to keep, such as queued,running.",
              "title": "State"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The request is not valid"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "The stored runs, oldest queue time first",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/v1/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No run has this id"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The request is not valid"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "One run, with its steps and the state of its runner",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/v1/runs/{run_id}/cancellation": {
      "put": {
        "operationId": "cancelRun",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResource"
                }
              }
            },
            "description": "A running run was asked to stop",
            "headers": {
              "Location": {
                "description": "The run, which reports when it stops",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No run has this id"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The run has already finished"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The request is not valid"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Cancel a run: at once when queued, at its next safe point when running",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/v1/runs/{run_id}/log": {
      "get": {
        "operationId": "getRunLog",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "No run has this id"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The request is not valid"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "The log excerpts of the run's steps, in step order",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/v1/system-status": {
      "get": {
        "operationId": "getSystemStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Which components work now and which actions they allow",
        "tags": [
          "system"
        ]
      }
    }
  }
}
