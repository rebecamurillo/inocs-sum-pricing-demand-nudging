{
  "components": {
    "schemas": {
      "ComponentName": {
        "description": "The parts of the system a run depends on, in the order they are reported.",
        "enum": [
          "storage",
          "pricing_model",
          "solver",
          "trip_planner"
        ],
        "title": "ComponentName",
        "type": "string"
      },
      "ComponentStatusResponse": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "name": {
            "$ref": "#/components/schemas/ComponentName"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "name",
          "available",
          "reason"
        ],
        "title": "ComponentStatusResponse",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "An error, as a problem document (RFC 9457).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "SystemStatusResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "can_read_stored_results": {
            "title": "Can Read Stored Results",
            "type": "boolean"
          },
          "can_start_runs": {
            "title": "Can Start Runs",
            "type": "boolean"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentStatusResponse"
            },
            "title": "Components",
            "type": "array"
          }
        },
        "required": [
          "api_version",
          "components",
          "can_read_stored_results",
          "can_start_runs"
        ],
        "title": "SystemStatusResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Dynamic pricing demonstrator API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/system-status": {
      "get": {
        "operationId": "getSystemStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Which components of the system work now",
        "tags": [
          "system"
        ]
      }
    }
  }
}
